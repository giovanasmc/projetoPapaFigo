.rodape {
  position: fixed;
  bottom: 20px;/* Distância em pixels da borda inferior */
  right: 90px;
  width: 80%;/* Garante que o texto ocupe boa parte da tela */
  text-align: center; /* Centraliza o texto (opcional) */
  z-index: 100;/* Mantém o texto visualmente acima de outros elementos */
  background-color: rgba(0, 0, 0, 0.6); /* Cor do fundo*/
  border: 2px solid #ffffff; /* Borda branca opcional */
  padding: 15px;/* Espaço interno para o texto não colar na borda */
  border-radius: 4px;/* Cantos levemente arredondados (remova se quiser perfeitamente reto) */
  color: white;/* Cor do texto dentro da div */
  margin: 10px 0; 
}

.pov {
  position: fixed;/* Fixa a imagem na tela, ela não se move com o scroll */
  bottom: 20px;/* Distância de 20 pixels da borda de baixo */
  left: 50px;/* Distância de 20 pixels da borda da esquerda */
  z-index: 100;/* Garante que ela fique na frente do fundo */
  pointer-events: none; /* Evita que a imagem atrapalhe cliques na barra do Twine */
  width: 200px;
  height: auto;
}